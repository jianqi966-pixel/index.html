<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>原子重组系统 - 实验室</title>
    <!-- 仅引入必要的 React 和 Tailwind 库，不包含任何外部跳转链接 -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 2px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(59, 130, 246, 0.3); border-radius: 10px; }
        body { background-color: #020617; margin: 0; overflow: hidden; -webkit-tap-highlight-color: transparent; }
        .glass-panel { background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // API 配置：空字符串将在运行时由环境自动填充
        const apiKey = ""; 

        const App = () => {
            const [day, setDay] = useState(0);
            const [isRefining, setIsRefining] = useState(false);
            const [progress, setProgress] = useState(0);
            const [status, setStatus] = useState("系统就绪");
            const [logs, setLogs] = useState(["> 环境扫描完成", "> 量子核心待命"]);
            const [aiMessage, setAiMessage] = useState("");
            const [isAiLoading, setIsAiLoading] = useState(false);
            
            const audioCtx = useRef(null);
            const logEndRef = useRef(null);

            useEffect(() => {
                logEndRef.current?.scrollIntoView({ behavior: "smooth" });
            }, [logs]);

            const initAudio = () => {
                if (!audioCtx.current) {
                    audioCtx.current = new (window.AudioContext || window.webkitAudioContext)();
                }
            };

            // ✨ 调用 Gemini 的函数 - 确保只有数据交换，没有页面跳转
            const triggerAiSync = async (e) => {
                if (e) e.preventDefault(); // 严防任何跳转行为
                if (isAiLoading) return;
                
                setIsAiLoading(true);
                initAudio();

                const prompt = `你是一个温柔的量子助手。现在实验进入第${day}天，正在将‘建齐’重组。请给‘歆惠’写一句极短的、科幻又深情的鼓励，不超过15个字。不要提及任何网站链接。`;

                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            contents: [{ parts: [{ text: prompt }] }]
                        })
                    });
                    const data = await response.json();
                    const text = data.candidates?.[0]?.content?.parts?.[0]?.text || "量子场产生共鸣...";
                    setAiMessage(text);
                    setLogs(prev => [...prev, `[AI反馈] ${text}`]);
                } catch (err) {
                    setAiMessage("量子波段暂不稳。");
                } finally {
                    setIsAiLoading(false);
                }
            };

            const runRefining = async () => {
                if (isRefining) return;
                initAudio();
                setIsRefining(true);
                setDay(0);
                setProgress(0);
                setLogs(["> 开始执行原子重组程序..."]);
                
                for (let i = 1; i <= 7; i++) {
                    await new Promise(r => setTimeout(r, 800));
                    setDay(i);
                    setProgress((i / 7) * 100);
                    
                    if (i < 7) {
                        setLogs(prev => [...prev, `> 周期 ${i}: 压力增加，原子排列优化中...`]);
                        setStatus("结构重构中...");
                    } else {
                        window.confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 } });
                        setLogs(prev => [...prev, "> 最终升华完成！‘建齐’已转化为‘歆惠’。"]);
                        setStatus("达成：永恒之钻");
                    }
                }
                setIsRefining(false);
            };

            return (
                <div className="min-h-screen flex items-center justify-center p-6 text-slate-100">
                    <div className="w-full max-w-sm glass-panel rounded-[2.5rem] p-8 shadow-2xl relative">
                        {/* 顶栏 */}
                        <div className="flex justify-between items-center mb-10">
                            <div className="text-[10px] font-mono tracking-tighter opacity-40 uppercase">Diamond Lab Pro</div>
                            <button 
                                type="button"
                                onClick={triggerAiSync}
                                className={`text-[9px] border border-blue-500/30 px-3 py-1 rounded-full transition-all ${isAiLoading ? 'opacity-50' : 'hover:bg-blue-500/20 text-blue-300'}`}
                            >
                                {isAiLoading ? "正在感应..." : "✨ 获取量子寄语"}
                            </button>
                        </div>

                        {/* 核心展示区 */}
                        <div className="bg-white/5 rounded-[2rem] py-12 mb-8 border border-white/5 text-center">
                            <div className={`text-8xl mb-4 transition-all duration-1000 ${day === 7 ? 'scale-110 drop-shadow-2xl' : 'scale-90 opacity-40'}`}>
                                {day === 7 ? '💎' : '⚫'}
                            </div>
                            <h2 className="text-3xl font-black mb-1">{day === 7 ? "歆惠" : "建齐"}</h2>
                            <p className="text-blue-500 text-[10px] font-bold tracking-widest uppercase">{status}</p>
                            
                            {aiMessage && (
                                <div className="mt-6 px-4 py-2 mx-4 bg-blue-500/10 border border-blue-500/20 rounded-xl text-[10px] text-blue-200 italic">
                                    “{aiMessage}”
                                </div>
                            )}
                        </div>

                        {/* 进度条 */}
                        <div className="mb-8">
                            <div className="flex justify-between items-end mb-2 font-mono">
                                <span className="text-2xl font-bold">{Math.round(progress)}%</span>
                                <span className="text-[10px] opacity-40">Phase 0{day}/07</span>
                            </div>
                            <div className="h-1 bg-slate-800 rounded-full overflow-hidden">
                                <div className="h-full bg-blue-500 transition-all duration-700" style={{ width: `${progress}%` }}></div>
                            </div>
                        </div>

                        {/* 控制按钮 */}
                        <button 
                            type="button"
                            onClick={runRefining} 
                            disabled={isRefining}
                            className={`w-full py-5 rounded-2xl font-black text-xs uppercase tracking-widest transition-all ${isRefining ? 'bg-slate-800 text-slate-600' : 'bg-white text-slate-950 hover:scale-[1.02] active:scale-95'}`}
                        >
                            {isRefining ? "重组运行中..." : (day === 7 ? "程序已圆满" : "启动原子重组")}
                        </button>
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
